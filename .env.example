# gowa
GOWA_BASE_URL=http://localhost:3000
GOWA_BASIC_AUTH=
GOWA_DEVICE_ID=
GOWA_WEBHOOK_SECRET=dev-secret
GOWA_WEBHOOK_SECRET_PREVIOUS=
WA_SEND_MIN_GAP_S=4

# watcher
DATABASE_URL=sqlite+aiosqlite:///./watcher.db
VAULT_ROOT=./vault

# CMS (ADR-0009) - leave CMS_BASE_URL empty to use the seed file instead
CMS_BASE_URL=
CMS_TOKEN=
CMS_SEED_PATH=~/projects/watcher-seed/members.json

PROPOSAL_EXPIRY_HOURS=24

# Decision Model (Jev, ADR-0006). Set JEV_BASE_URL to use the real
# JevClient; endpoint shapes (/choice, /noul, /score) are provisional -
# see shared/models/decision.py and adjust JevClient if they don't
# match your actual Jev API. Leave empty to fall back to
# WorkerBackedDecisionModel (every Decision Model question answered by
# the Worker model instead).
JEV_BASE_URL=
JEV_API_KEY=

# Worker/Mentor (Pydantic AI over an OpenAI-compatible endpoint)
MODELS_BASE_URL=https://openrouter.ai/api/v1
MODELS_API_KEY=
WORKER_MODEL_NAME=z-ai/glm-5.3-flash
MENTOR_MODEL_NAME=anthropic/claude-sonnet-5
DECISION_CONFIDENCE_THRESHOLD=0.6

# Batch cutting / thread lifecycle (Spec: WhatsApp Agent ingestion)
BATCH_N=40
BATCH_T_MINUTES=180
BATCH_QUIET_MINUTES=5
THREAD_STALE_DAYS=3
THREAD_SILENT_DAYS=7

# Lapis - leave LAPIS_TOKEN empty to use a local directory (VAULT_ROOT)
# instead of the real wiki (safe default, see default_vault_client())
LAPIS_BASE_URL=https://lapis.dvenom.in
LAPIS_VAULT_ID=aries
LAPIS_TOKEN=

BOT_MENTION_NAME=watcher
